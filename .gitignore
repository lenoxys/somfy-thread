# ESP-IDF / build
build/
build-*/
sdkconfig
sdkconfig.old
version.txt
managed_components/
dependencies.lock
*.pyc
__pycache__/

# host test binaries
/tmp/t
test/t

# vendored third-party JS (fetched by web/vendor/fetch.sh at build time)
web/vendor/*.js

# vendor hardware reference (Ebyte E07 datasheets/PCB libs — kept local, not redistributed)
doc/

# editor / OS
.vscode/
.idea/
.DS_Store

# release firmware mirrored into the site at deploy time (.github/workflows/pages.yml)
web/fw/

# firmware binaries (local-build artifact, release bins live on GitHub Releases)
*.bin
*.ota
